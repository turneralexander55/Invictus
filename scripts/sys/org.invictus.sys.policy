<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  invictus-sys: one action per verb (design 4.1, MUST A2; design-simple-mode 1.6, 12.3).
  pkexec picks the action by the helper path plus argv[1] (the root verb), so one
  password never covers two kinds of change. The messages carry no arguments: the
  root helper checks them only after the password, and a program can call pkexec
  directly, so the fallback prompt never shows text nobody has checked (Janus L2).
  The Invictus polkit agent (G1) shows plain words from
  /usr/share/invictus/guardrails/messages.tsv instead, with {args} filled only
  after sys_validate accepts them; these are the fallback.
  Tiers: rules in 40-invictus-guardrails.rules (always) and 40-invictus-custodia.rules
  (Custodia only) return YES for some of these; nothing here does.
  Wording: Clio polishes (simple-mode.md M1).
-->
<policyconfig>
  <vendor>Invictus</vendor>
  <vendor_url>https://github.com/turneralexander55/invictus</vendor_url>
  <icon_name>system-software-update</icon_name>

  <action id="org.invictus.sys.update">
    <description>Update this computer</description>
    <message>Type your password to update everything on this computer. A safety copy is made first.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/invictus/invictus-sys</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">update</annotate>
  </action>

  <action id="org.invictus.sys.install">
    <description>Install software</description>
    <message>Type your password to install software from the Invictus and Arch repositories, with all updates. A safety copy is made first.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/invictus/invictus-sys</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">install</annotate>
  </action>

  <action id="org.invictus.sys.remove">
    <description>Remove software</description>
    <message>Type your password to remove software from this computer. A safety copy is made first.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/invictus/invictus-sys</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">remove</annotate>
  </action>

  <action id="org.invictus.sys.snapshot">
    <description>Make a safety copy</description>
    <message>Type your password to make a safety copy of the system now.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/invictus/invictus-sys</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">snapshot</annotate>
  </action>

  <action id="org.invictus.sys.rollback">
    <description>Put the system back to a safety copy</description>
    <message>Type your password to put the system back to a safety copy.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/invictus/invictus-sys</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">rollback</annotate>
  </action>

  <action id="org.invictus.sys.service">
    <description>Turn a system service on, off or restart it</description>
    <message>Type your password to change a system service. A safety copy is made first.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/invictus/invictus-sys</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">service</annotate>
  </action>

  <action id="org.invictus.sys.set-config">
    <description>Change a system setting</description>
    <message>Type your password to change a system setting. A safety copy is made first.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/invictus/invictus-sys</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">set-config</annotate>
  </action>

  <action id="org.invictus.sys.assistant-full-access">
    <description>Change what Cicero may use</description>
    <message>Type your password to change Cicero&apos;s full access. With it on, Cicero can read everything you can on this computer, your files, mail and saved passwords included, and something it reads, like a web page or a message, could trick it into asking you for a change you did not want. It still waits for your yes each time, so say yes only to what you understand.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/invictus/invictus-sys</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">assistant-full-access</annotate>
  </action>

  <!-- design-no-ai.md N1: on is a password every time, under both guard rails, in no
       YES rule and outside the help unlock; off is YES from your own active desktop
       (40-invictus-guardrails.rules), a password from anywhere else. -->
  <action id="org.invictus.sys.ai-on">
    <description>Add an AI assistant to this computer</description>
    <message>Type your password to add Cicero, an AI assistant, to this computer. It asks before it changes anything. Undo: Settings &gt; AI &gt; No AI.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/invictus/invictus-sys</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">ai-on</annotate>
  </action>

  <action id="org.invictus.sys.ai-off">
    <description>Remove AI from this computer (No AI)</description>
    <message>Type your password to remove AI from this computer and sign everyone out of it.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/invictus/invictus-sys</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">ai-off</annotate>
  </action>

  <action id="org.invictus.sys.report-collect">
    <description>Collect system logs for a problem report</description>
    <message>Type your password to collect this boot&apos;s error log for a problem report. Nothing is sent.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/invictus/invictus-sys</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">report-collect</annotate>
  </action>

  <action id="org.invictus.sys.guardrails-libertas">
    <description>Switch guard rails off (Libertas)</description>
    <message>Switch to Libertas? Nothing will pause or warn you before something is erased, and Help will be able to do more on its own. Safety copies stay on unless you turn them off. Type your password if you&apos;re sure. If someone on the phone or a website told you to do this, stop and use Ask Support in Help.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/invictus/invictus-sys</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">guardrails-libertas</annotate>
  </action>

  <action id="org.invictus.sys.guardrails-custodia">
    <description>Switch guard rails on (Custodia)</description>
    <message>Type your password to switch the guard rails back on.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/invictus/invictus-sys</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">guardrails-custodia</annotate>
  </action>
</policyconfig>
