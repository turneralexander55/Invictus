# Maintainer: Alex Turner (turneralexander55)
#
# Meta package: depends only, no files. What each set is for and why each
# package is in it: docs/packages.md.
#
# Development: build tools, git, the two editors, JavaScript and Python,
# rootless containers, and the search tools agents and people both use.
# Works on a machine without a desktop too (the editors then just go
# unused). No AI here: Claude Code is in invictus-moneta, so a No AI
# machine can still have the dev tools (design-no-ai.md N5).

pkgname=invictus-dev
pkgver=0.3.0
pkgrel=2
pkgdesc='Invictus development tools'
arch=('any')
url='https://github.com/turneralexander55/invictus'
license=('GPL-3.0-or-later')
depends=(
  # building packages (the AUR too), version control
  'base-devel' 'git' 'github-cli'

  # editors: Zed (the Super+T bind) and Microsoft's VS Code (marketplace
  # extensions, Remote; Alex, 2026-09-30), built from our pin in pkgs/aur
  'zed' 'visual-studio-code-bin'

  # languages
  'nodejs' 'npm' 'python'

  # rootless containers; crun is the runtime (podman needs one and would
  # otherwise ask)
  'podman' 'podman-compose' 'crun'

  # command line tools for code: search, find, JSON
  'ripgrep' 'fd' 'jq'
)
optdepends=(
  'uv: Python projects and tools'
  'rustup: Rust toolchains'
  'go: Go toolchain'
  'shellcheck: lint shell scripts (this repo checks with it)'
  'distrobox: other distributions in containers'
)

package() {
  :
}
