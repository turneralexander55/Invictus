# Maintainer: Alex Turner (turneralexander55)
#
# Meta package: depends only, no files. What each set is for and why each
# package is in it: docs/packages.md. tests/pkgs checks every name against
# pkgs/meta/sources.txt (verified in an Arch container by
# tests/pkgs/live-arch.sh) and that no package sits in two sets.
#
# The system under any Invictus machine: boots, updates, snapshots, gets
# online. Headless-safe: no graphics, audio or desktop here (those are
# invictus-desktop, which must work without this set, because adopt.sh
# installs it on machines that never get invictus-base).
#
# NOT for an existing install until Phase 3: it pulls the limine boot hooks
# and snap-pac, which change how the machine boots and updates. The ISO and
# installer use it; scripts/dev/adopt.sh never installs it.

pkgname=invictus-base
pkgver=0.2.0
pkgrel=1
pkgdesc='Invictus base system: kernels, firmware, btrfs snapshots, limine boot, network, everyday command line'
arch=('any')
url='https://github.com/turneralexander55/invictus'
license=('GPL-3.0-or-later')
depends=(
  # Arch's minimal system, and the key that trusts our repo
  'base' 'invictus-keyring'

  # kernels (linux-lts is the second boot entry, design 2.1), firmware and
  # microcode for both CPU makers (friends' laptops are often Intel CPU +
  # AMD or Intel graphics), laptop audio firmware
  'linux' 'linux-lts' 'mkinitcpio'
  'linux-firmware' 'sof-firmware' 'amd-ucode' 'intel-ucode'
  'fwupd'

  # boot: limine with bootable snapshots (hooks from the AUR, pkgs/aur/)
  'limine' 'limine-mkinitcpio-hook' 'limine-snapper-sync' 'efibootmgr'

  # file systems: btrfs root with snapper; FAT for the ESP, exFAT and NTFS
  # for USB sticks and Windows disks
  'btrfs-progs' 'snapper' 'snap-pac'
  'dosfstools' 'exfatprogs' 'ntfs-3g'

  # network
  'networkmanager' 'openssh'

  # polkit (invictus-sys authorises through it), package cache cleanup
  'polkit' 'pacman-contrib'

  # everyday command line
  'sudo' 'nano' 'less' 'tree' 'man-db' 'man-pages'
  'unzip' 'zip' '7zip' 'rsync' 'usbutils' 'lm_sensors'
)

package() {
  :
}
