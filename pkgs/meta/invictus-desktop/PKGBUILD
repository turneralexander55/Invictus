# Maintainer: Alex Turner (turneralexander55)
#
# Meta package plus the desktop config. What each set is for and why each
# package is in it: docs/packages.md. tests/pkgs checks every name against
# pkgs/meta/sources.txt (verified in an Arch container by
# tests/pkgs/live-arch.sh), that no package sits in two sets, and that
# every command the shipped config runs comes from this set or a flavour.
#
# The graphical session both flavours share (Tessera: tiling; Atrium:
# windows and a taskbar): Hyprland, login, portals, audio, bluetooth,
# power, keyring, files, viewers, fonts, the shell the shipped ~/.zshrc
# needs. It must work without invictus-base (adopt.sh installs it on
# machines that never get invictus-base), so it names what it runs itself.
#
# Files it installs:
#   /usr/share/invictus/hypr/invictus/*.lua   the shipped Hyprland modules,
#                                             loaded by ~/.config/hypr/hyprland.lua
#   /usr/share/invictus/config/               defaults copied once into a home
#                                             (laid out like ~/.config; shell/zshrc
#                                             is ~/.zshrc)
#   /usr/share/invictus/pinned-hypr.txt       the tested hypr* versions, for
#                                             invictus-doctor
#   /usr/share/applications/invictus-*.desktop  Change theme, Change motion
#   invictus-first-login user unit            copies the defaults on first login;
#                                             enabled for every user
# Files come from this repo (config/, pkgs/pinned/, scripts/) at the same
# commit as this PKGBUILD: bump pkgrel when any of them changes.
#
# The hypr* set itself comes from pkgs/pinned/ (exact Arch files, served
# from [invictus] ahead of [extra]); the names below stay plain so any
# repo can satisfy them.

pkgname=invictus-desktop
pkgver=0.3.0
pkgrel=4
pkgdesc='Invictus desktop session shared by Tessera and Atrium, and its config'
arch=('any')
url='https://github.com/turneralexander55/invictus'
license=('GPL-3.0-or-later')
depends=(
  # our commands and branding
  'invictus-tools' 'invictus-branding'

  # AMD graphics: OpenGL, Vulkan, VA-API video decode (radeonsi, in mesa)
  'mesa' 'vulkan-radeon'

  # Hyprland and its tools (pinned set in [invictus]); hyprshutdown closes
  # apps cleanly on log out
  'hyprland' 'hyprpaper' 'hypridle' 'hyprlock' 'hyprpolkitagent' 'hyprshutdown'
  'xdg-desktop-portal' 'xdg-desktop-portal-hyprland' 'xdg-desktop-portal-gtk'
  'qt6-wayland' 'qt6-svg'

  # login
  'sddm'

  # session services: sound, bluetooth, power profiles
  # and battery, the secret store (FreeRDP and first boot keep passwords
  # there), home folders, opening files and links
  'pipewire' 'pipewire-alsa' 'pipewire-pulse' 'wireplumber'
  'bluez' 'bluez-utils' 'blueman'
  'power-profiles-daemon' 'upower'
  'gnome-keyring' 'libsecret'
  'xdg-user-dirs' 'xdg-utils'

  # notifications, terminal
  'swaync' 'kitty'

  # clipboard, screenshots, media and brightness keys
  'wl-clipboard' 'hyprshot' 'brightnessctl' 'playerctl'

  # files: Thunar with removable drives, phones, network shares, archives
  # and thumbnails
  'thunar' 'thunar-volman' 'thunar-archive-plugin' 'tumbler' 'ffmpegthumbnailer'
  'gvfs' 'gvfs-mtp' 'gvfs-smb' 'file-roller'

  # open what people download: photos, video and music, PDFs; the codecs
  # behind them (GStreamer, with VA-API decode)
  'loupe' 'showtime' 'papers'
  'gst-plugins-good' 'gst-plugins-bad' 'gst-plugins-ugly' 'gst-libav' 'gst-plugin-va'

  # browser (AUR until pkgs/aur carries it)
  'zen-browser-bin'

  # look: icons, the cursor env.lua sets (XCURSOR_THEME), the GTK theme
  # invictus-theme recolours, qt6ct for Qt apps (QT_QPA_PLATFORMTHEME)
  'papirus-icon-theme' 'capitaine-cursors' 'adw-gtk-theme' 'qt6ct'

  # fonts: the UI and mono face, bar and terminal glyphs, Latin, Greek,
  # Cyrillic and most other scripts, emoji (Noto), metric-compatible
  # Arial/Times/Courier; fontconfig for fc-cache at first login. Chinese,
  # Japanese and Korean (noto-fonts-cjk, 300 MB) is an installer extra.
  'fontconfig' 'ttf-ibm-plex' 'ttf-nerd-fonts-symbols-mono'
  'noto-fonts' 'noto-fonts-emoji' 'ttf-liberation'

  # the shipped ~/.zshrc: zsh, its two plugins, the spaceship prompt
  # (pkgs/aur/), fastfetch on every new shell
  'zsh' 'zsh-syntax-highlighting' 'zsh-autosuggestions' 'spaceship-prompt'
  'fastfetch'
)
optdepends=(
  # Not a depends: waybar, ffmpeg and cava need "jack", which an existing
  # install already has as jack2, and pipewire-jack conflicts with it, so
  # pacman --noconfirm would refuse the update. The ISO names it as a
  # target, so a fresh install resolves "jack" to it.
  'pipewire-jack: JACK apps play through PipeWire (replaces jack2)'
  'invictus-tessera: the tiling flavour (bar, launcher, binds)'
  'invictus-atrium: the windows-and-taskbar flavour and everyday apps'
  'libva-utils: vainfo, to check video decode on the GPU'
  'seahorse: see and edit what the keyring holds'
  'noto-fonts-cjk: Chinese, Japanese and Korean text (an installer extra)'
)

package() {
  local root="$startdir/../../.."
  local share="$pkgdir/usr/share/invictus"

  # Shipped Hyprland modules: replaced on every update. moneta.lua (Super+A)
  # belongs to invictus-tribune, the AI set: a No AI desktop has no panel.
  local m
  for m in "$root"/config/hypr/invictus/*.lua; do
    [[ "${m##*/}" == moneta.lua ]] && continue
    install -Dm644 -t "$share/hypr/invictus" "$m"
  done

  # Copy-once defaults: everything in config/ except the shipped modules.
  local f rel
  while IFS= read -r -d '' f; do
    rel="${f#"$root"/config/}"
    [[ "$rel" == hypr/invictus/* || "$rel" == applications/* ]] && continue
    install -Dm644 "$f" "$share/config/$rel"
  done < <(find "$root/config" -type f -print0)

  # Menu entries (Change theme, Change motion): system-wide, not per home.
  install -Dm644 -t "$pkgdir/usr/share/applications" "$root"/config/applications/*.desktop

  # Tested hypr* versions (name version), for invictus-doctor.
  install -dm755 "$share"
  grep -v '^[[:space:]]*\(#\|$\)' "$root/pkgs/pinned/hypr.lock" | cut -d' ' -f1,2 > "$share/pinned-hypr.txt"
  chmod 644 "$share/pinned-hypr.txt"

  # First login: the script and a user unit enabled for every user.
  install -Dm755 "$root/scripts/first-login.sh" "$pkgdir/usr/lib/invictus/first-login"
  install -Dm644 "$root/scripts/systemd/invictus-first-login.service" \
    "$pkgdir/usr/lib/systemd/user/invictus-first-login.service"
  install -dm755 "$pkgdir/usr/lib/systemd/user/default.target.wants"
  ln -s ../invictus-first-login.service \
    "$pkgdir/usr/lib/systemd/user/default.target.wants/invictus-first-login.service"
}
