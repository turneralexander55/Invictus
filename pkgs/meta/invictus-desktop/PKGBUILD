# Maintainer: Alex Turner (turneralexander55)
#
# Meta package: depends only, no files. The list came from the old
# legacy/packages/*.txt with the fixes in docs/design.md 1.2. AUR packages
# named here must be built into [invictus] (pkgs/aur/) before this installs.
# tests/hyprland-lua checks that every command the Hyprland config runs is
# provided by one of the metas.

# The Hyprland desktop, and (since Phase 1) its config:
#   /usr/share/invictus/hypr/invictus/*.lua   the shipped Hyprland modules,
#                                             loaded by ~/.config/hypr/hyprland.lua
#   /usr/share/invictus/config/               defaults copied once into a home
#                                             (laid out like ~/.config; shell/zshrc
#                                             is ~/.zshrc)
#   /usr/share/invictus/pinned-hypr.txt       the tested hypr* versions, for
#                                             invictus-doctor
#   /usr/share/applications/invictus-*.desktop  Change theme, Change motion
#   invictus-first-login user unit            copies the defaults on first login;
#                                             enabled for every user
# Files come from this repo (config/, pkgs/pinned/, scripts/) at the same
# commit as this PKGBUILD: bump pkgrel when any of them changes.
#
# The hypr* set itself comes from pkgs/pinned/ (exact Arch files, served
# from [invictus] ahead of [extra]); the names below stay plain so any
# repo can satisfy them.
#
# Fixes from design 1.2: mako dropped (swaync is the notification daemon);
# added what binds, autostart and the waybar scripts call but the old list
# missed: xwaylandvideobridge, discord, brightnessctl, playerctl, jq, plus
# pacman-contrib (checkupdates), lm_sensors (sensors) and libnotify.

pkgname=invictus-desktop
pkgver=0.2.0
pkgrel=1
pkgdesc='Invictus Hyprland desktop'
arch=('any')
url='https://github.com/turneralexander55/invictus'
license=('GPL-3.0-or-later')
depends=(
  # our commands and branding
  'invictus-tools' 'invictus-branding'

  # Hyprland and its tools (pinned set in [invictus] from Phase 1)
  'hyprland' 'hyprpaper' 'hypridle' 'hyprlock' 'hyprpolkitagent'
  'xdg-desktop-portal' 'xdg-desktop-portal-hyprland' 'xdg-desktop-portal-gtk'
  'xorg-xwayland' 'xwaylandvideobridge' 'qt6-wayland' 'dbus'

  # bar, launcher, terminal, notifications, login
  'waybar' 'rofi' 'kitty' 'swaync' 'sddm'
  'qt6-svg' 'qt6-declarative' 'qt6-5compat'

  # clipboard, screenshots, media and hardware keys
  'wl-clipboard' 'cliphist' 'hyprshot'
  'wireplumber' 'brightnessctl' 'playerctl'
  'pavucontrol' 'nm-connection-editor'

  # waybar scripts and the keybinding cheatsheet
  'pacman-contrib' 'lm_sensors' 'sysstat' 'libnotify' 'jq'

  # files
  'thunar' 'thunar-volman' 'tumbler' 'gvfs' 'gvfs-mtp' 'gvfs-smb' 'yazi'

  # apps the binds open
  'zen-browser-bin' 'zed' 'discord'

  # look
  'nwg-look' 'papirus-icon-theme' 'adwaita-cursors' 'nordic-darker-theme'
  'ttf-dejavu' 'noto-fonts' 'noto-fonts-cjk' 'noto-fonts-emoji'
  'ttf-jetbrains-mono' 'ttf-nerd-fonts-symbols'

  # shell and terminal tools
  'zsh' 'zsh-syntax-highlighting' 'zsh-autosuggestions'
  'fastfetch' 'btop' 'cava'
)
optdepends=(
  'invictus-gaming: Steam for the Super+G bind'
)

package() {
  local root="$startdir/../../.."
  local share="$pkgdir/usr/share/invictus"

  # Shipped Hyprland modules: replaced on every update.
  install -Dm644 -t "$share/hypr/invictus" "$root"/config/hypr/invictus/*.lua

  # Copy-once defaults: everything in config/ except the shipped modules.
  local f rel
  while IFS= read -r -d '' f; do
    rel="${f#"$root"/config/}"
    [[ "$rel" == hypr/invictus/* || "$rel" == applications/* ]] && continue
    install -Dm644 "$f" "$share/config/$rel"
  done < <(find "$root/config" -type f -print0)

  # Menu entries (Change theme, Change motion): system-wide, not per home.
  install -Dm644 -t "$pkgdir/usr/share/applications" "$root"/config/applications/*.desktop

  # Tested hypr* versions (name version), for invictus-doctor.
  install -dm755 "$share"
  grep -v '^[[:space:]]*\(#\|$\)' "$root/pkgs/pinned/hypr.lock" | cut -d' ' -f1,2 > "$share/pinned-hypr.txt"
  chmod 644 "$share/pinned-hypr.txt"

  # First login: the script and a user unit enabled for every user.
  install -Dm755 "$root/scripts/first-login.sh" "$pkgdir/usr/lib/invictus/first-login"
  install -Dm644 "$root/scripts/systemd/invictus-first-login.service" \
    "$pkgdir/usr/lib/systemd/user/invictus-first-login.service"
  install -dm755 "$pkgdir/usr/lib/systemd/user/default.target.wants"
  ln -s ../invictus-first-login.service \
    "$pkgdir/usr/lib/systemd/user/default.target.wants/invictus-first-login.service"
}
