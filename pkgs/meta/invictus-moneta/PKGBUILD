# Maintainer: Alex Turner (turneralexander55)
#
# Meta package: depends only, no files. What each set is for and why each
# package is in it: docs/packages.md.
#
# The AI set's meta (design-no-ai.md N5; design.md 1.3's invictus-assistant
# split into invictus-sys, always installed, and this). Installed only when
# someone picks an AI at first start or in Settings (invictus-sys ai on); a
# machine set to No AI has none of it on disk. Nothing outside the AI set
# may depend on it, directly or transitively: tests/pkgs/run.sh checks the
# PKGBUILDs, tests/pkgs/no-ai-in-base.sh checks the built repo (NA3). The
# panel, the plugin and MCP server, the providers and invictus-collegium
# join here as they are built; invictus-voice (whisper) stays its own set.

pkgname=invictus-moneta
pkgver=0.1.0
pkgrel=1
pkgdesc='Invictus Moneta, the AI assistant: Claude Code now, the panel later (AI; opt-in)'
arch=('any')
url='https://github.com/turneralexander55/invictus'
license=('GPL-3.0-or-later')
depends=(
  'invictus-desktop'

  # Claude Code, built from our pin in pkgs/aur
  'claude-code'
)

package() {
  :
}
