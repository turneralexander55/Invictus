# Maintainer: Alex Turner (turneralexander55)
#
# Meta package: depends only, no files. The list came from the old
# legacy/packages/*.txt with the fixes in docs/design.md 1.2. AUR packages
# named here must be built into [invictus] (pkgs/aur/) before this installs.
# tests/hyprland-lua checks that every command the Hyprland config runs is
# provided by one of the metas.

# Needs [multilib] enabled for steam and the lib32 drivers.

pkgname=invictus-gaming
pkgver=0.1.0
pkgrel=1
pkgdesc='Invictus gaming: Steam, Proton GE, gamescope, MangoHud, Lutris'
arch=('any')
url='https://github.com/turneralexander55/invictus'
license=('GPL-3.0-or-later')
depends=(
  'steam'
  # name the 32-bit Vulkan driver so Steam does not pull a different one
  'lib32-mesa' 'lib32-vulkan-radeon'
  'gamescope' 'mangohud' 'lib32-mangohud'
  'gamemode' 'lib32-gamemode'
  'umu-launcher' 'lutris'
  'proton-ge-custom-bin'
)

package() {
  :
}
