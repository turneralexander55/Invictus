# Make the derived files match /etc/invictus/guardrails (design-simple-mode
# 1.3, 1.6): the installer writes the file and runs apply too; a missing
# file reads as custodia. A failure here never fails the transaction.
post_install() {
  usr/lib/invictus/guardrails apply || echo "invictus-guardrails: apply failed; run: sudo invictus-sys guardrails apply"
}

post_upgrade() {
  post_install
}

# Take the derived files away first, so sudo, pacman and PAM do not point
# at files that are about to go.
pre_remove() {
  usr/lib/invictus/guardrails uninstall || true
}
