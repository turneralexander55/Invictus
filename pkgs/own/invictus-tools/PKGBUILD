# Maintainer: Alex Turner (turneralexander55)
#
# The runtime commands the desktop calls, plus invictus-update and
# invictus-doctor. Files come from this repo (scripts/, theme/,
# tests/hyprland-lua/) at the same commit as this PKGBUILD: bump pkgrel
# when any of them changes, or the published package is reused.
#
#   /usr/bin/invictus-theme, invictus-motion, invictus-update, invictus-doctor,
#   invictus-first-boot, and /usr/share/invictus/first-boot/*.qml (the
#   first-start screens; Quickshell comes with invictus-desktop)
#   /usr/lib/invictus/show-keybindings, confirm            (Hyprland binds)
#   /usr/lib/invictus/waybar/{alert,updates}               (waybar modules)
#   /usr/lib/invictus/lib/defaults.sh                      (shared shell code)
#   /usr/lib/invictus/pending-extras, invictus-extras.service, and
#   /usr/share/invictus/extras.list                         (installer extras)
#   /usr/lib/invictus/doctor/                              (the stub config check:
#       the same mock of `hl` the tests use, checked against the API stubs
#       /usr/share/hypr/stubs/hl.meta.lua that the hyprland package ships)

pkgname=invictus-tools
pkgver=0.1.0
pkgrel=10
pkgdesc='Invictus commands: theme, motion, update, doctor, and the scripts the desktop runs'
arch=('any')
url='https://github.com/turneralexander55/invictus'
license=('GPL-3.0-or-later')
depends=(
  'bash' 'python' 'lua' 'invictus-branding'
  # pending-extras and the doctor read /usr/lib/invictus/lib/{pacman,
  # guardrails-state}.sh; Settings and the desktop call invictus-sys;
  # invictus-first-boot and invictus-theme load lib/invictus_env.py (0.2.0-4);
  # 0.2.0-5 owns the systemd-ssh-generator mask, so adopted installs get it
  'invictus-sys>=0.2.0-6'
  # waybar modules (checkupdates, free), the cheatsheet and pickers
  # (rofi, notify-send), pkill, gsettings for the GTK look
  'pacman-contrib' 'libnotify' 'rofi' 'util-linux' 'procps-ng' 'glib2'
  # doctor: diff, findmnt, the keysym list for the stub check
  'diffutils' 'libxkbcommon'
)
optdepends=(
  'hyprland: invictus-doctor runs Hyprland --verify-config'
  'snapper: invictus-doctor lists root snapshots'
  'paru: invictus-update --aur'
)

package() {
  local root="$startdir/../../.."
  local lib="$pkgdir/usr/lib/invictus"

  install -Dm755 "$root/theme/invictus-theme" "$pkgdir/usr/bin/invictus-theme"
  install -Dm755 "$root/scripts/invictus-update.sh" "$pkgdir/usr/bin/invictus-update"
  install -Dm755 "$root/scripts/invictus-doctor.sh" "$pkgdir/usr/bin/invictus-doctor"
  install -Dm755 "$root/scripts/invictus-motion.sh" "$pkgdir/usr/bin/invictus-motion"
  install -Dm755 "$root/scripts/first-boot/invictus-first-boot" "$pkgdir/usr/bin/invictus-first-boot"
  install -Dm644 -t "$pkgdir/usr/share/invictus/first-boot" "$root"/quickshell/first-boot/*.qml

  install -Dm755 "$root/scripts/show-keybindings.sh" "$lib/show-keybindings"
  install -Dm755 "$root/scripts/confirm.sh" "$lib/confirm"
  # cpu, gpu and memory.sh stay in the repo only for machines on the old
  # config (it calls them from the clone); the new bar uses alert instead.
  local f
  for f in alert updates; do
    install -Dm755 "$root/scripts/waybar/$f.sh" "$lib/waybar/$f"
  done

  install -Dm644 "$root/scripts/lib/defaults.sh" "$lib/lib/defaults.sh"
  # Installer extras (docs/packages.md, "Extras"): the list the installer's
  # extras job and pending-extras accept, and the service that installs
  # them on the first start with internet (enabled by the installer only
  # when something is pending).
  install -Dm644 "$root/scripts/lib/extras.list" "$pkgdir/usr/share/invictus/extras.list"
  install -Dm755 "$root/scripts/invictus-extras.sh" "$lib/pending-extras"
  install -Dm644 "$root/scripts/systemd/invictus-extras.service" \
    "$pkgdir/usr/lib/systemd/system/invictus-extras.service"
  install -Dm644 -t "$lib/doctor" \
    "$root/scripts/doctor/hypr-check.lua" \
    "$root/tests/hyprland-lua/mock_hl.lua" \
    "$root/tests/hyprland-lua/api.lua" \
    "$root/tests/hyprland-lua/hyprrequire.lua"
}
