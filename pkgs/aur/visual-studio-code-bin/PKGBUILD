# Copied from the AUR: https://aur.archlinux.org/visual-studio-code-bin.git
# aur-commit: 7fe183483fa69f1559b4ccd27d858d10353f81b1 (1.139.1-1, 2026-09-25)
# Reviewed 2026-09-30 by Vulcan: repackages Microsoft's x86_64 .deb from
# update.code.visualstudio.com (the marketplace build Alex chose over
# Code - OSS) into /usr/share/code, with a /usr/bin/code launcher that adds
# ~/.config/code-flags.conf. The .install only prints that hint. No build
# step, no network after the download; chrome-sandbox loses its setuid bit
# (Arch kernels have user namespaces).
# Signatures: the .deb has no detached signature. Microsoft signs its apt
# index (InRelease, key BC52 8686 B50D 79E3 39D3 721C EB3E 94AD BE12 29CF in
# upstream/, from packages.microsoft.com/keys/microsoft.asc), which lists
# the .deb's sha256. upstream-check.sh checks our pinned sha256 is in that
# signed index; scripts/dev/bump-aur.sh runs it on every bump. Checked
# 2026-09-30: 1.139.1-1790309529 matches.
# Changes from the AUR copy:
#   - x86_64 only (arch and the aarch64 and armv7h sources dropped): AMD
#     PCs only;
#   - the .install is dropped: it only printed the code-flags.conf hint
#     (with tput, which fails without a terminal);
#   - source= lines quoted for ShellCheck (same strings);
#   - upstream-check.sh and upstream/ added (not used by the build).
# Update: scripts/dev/bump-aur.sh visual-studio-code-bin (docs/packages.md,
# "AUR pins"). Monthly releases plus fixes; bump with the weekly check.
#
# Maintainer: D. Can Celasun <can[at]dcc[dot]im>

pkgname=visual-studio-code-bin
_pkgname=visual-studio-code
pkgver=1.139.1
pkgrel=1
pkgdesc="Visual Studio Code (vscode): Editor for building and debugging modern web and cloud applications (official binary version)"
arch=('x86_64')
url="https://code.visualstudio.com/"
license=('custom: commercial')
provides=('code' 'vscode')
conflicts=('code')
# Upstream has signature verification for extensions and stripping breaks it
# See https://github.com/microsoft/vscode/issues/223455#issuecomment-2610001754
options=(!strip)
# lsof: needed for terminal splitting, see https://github.com/Microsoft/vscode/issues/62991
# xdg-utils: needed for opening web links with xdg-open
depends=(libxkbfile gnupg gtk3 libsecret nss gcc-libs libnotify libxss glibc lsof shared-mime-info xdg-utils alsa-lib)
optdepends=('glib2: Needed for move to trash functionality'
            'libdbusmenu-glib: Needed for KDE global menu'
            'org.freedesktop.secrets: Needed for settings sync'
             # See https://github.com/MicrosoftDocs/live-share/issues/4650
            'icu69: Needed for live share' )
source=("${_pkgname}-bin.sh")
source_x86_64=("code_${pkgver}_amd64.deb::https://update.code.visualstudio.com/${pkgver}/linux-deb-x64/stable")
sha256sums=('bd0d9edf69283ebdf4e73e0a7b168d2fcf50acbd01f63674cad93ed4fe42fdad')
sha256sums_x86_64=('cc8e35cf69ff4c7e515e19fa981bf6aba41f61ddb61c79370e9fe460c5dbaf8b')

package() {
  bsdtar -xf data.tar.xz -C "${pkgdir}/"

  install -d "${pkgdir}/usr/bin"
  install -d "${pkgdir}/usr/share/licenses/${pkgname}"

  ln -s /usr/share/code/resources/app/LICENSE.rtf \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.rtf"

  # Launcher
  install -m755 "${srcdir}/${_pkgname}-bin.sh" "${pkgdir}/usr/bin/code"

  # Fix the desktop entries
  sed -i \
    -e 's/^\(Exec=\)[^ ]*/\1code/g' \
    "${pkgdir}"/usr/share/applications/*.desktop

  # setuid on chrome-sandbox
  # Comment out if using a kernel without user namespaces, like linux-hardened
  chmod u-s "${pkgdir}/usr/share/code/chrome-sandbox"
}
