# Copied from the AUR: https://aur.archlinux.org/calamares.git
# aur-commit: 167151beb537c06cb75c8dbfd409799ba308bb66 (3.4.2-2, 2026-03-23)
# Reviewed 2026-09-30 by Vulcan; the build changes are Vulcan 2's (ISO,
# design 2.1): builds Calamares from its Codeberg release tarball with
# cmake and ninja, installs with DESTDIR. No install scripts, no network
# after the download. Live ISO only: no set installs it, the installer's
# cleanup job removes it from the installed system.
# Changes from the AUR copy (pkgrel 2.2):
#   - packagechooser is built (the AUR build skips it): the Advanced install
#     path uses it for the Atrium/Tessera and Custodia/Libertas choices;
#   - python is named, so the Python job modules (unpackfs,
#     mount, fstab, initcpiocfg, services-systemd, ...) are always built
#     instead of depending on what the build chroot happens to have;
#   - our "I've saved my files" page (installer/diskcheck in this repo) is
#     copied into src/modules/ and built with the rest. Bump pkgrel when
#     installer/diskcheck changes;
#   - the tarball's signature is checked: the .asc is a source (sha256
#     pinned) and validpgpkeys names Adriaan de Groot's key (keys/pgp/,
#     from his Codeberg account; the release notes name the signing
#     subkey 6D08 3784 1C06 8A23 3F24 127B 14B6 CC38 1BC2 56D6). The
#     tarball's sha256 is unchanged from the AUR and matches the notes;
#   - x86_64 only (i686 dropped); the source= line re-quoted for
#     ShellCheck (same URL).
# Update: scripts/dev/bump-aur.sh calamares (docs/packages.md, "AUR
# pins"); the ISO's Calamares schemas move with it (tests/iso).
#
# Maintainer:
# Contributor: Rustmilian Rustmilian@proton.me

_pkgname="calamares"
pkgname="$_pkgname"
pkgver=3.4.2
pkgrel=2.2
pkgdesc="Distribution-independent installer framework"
url="https://codeberg.org/Calamares/calamares"
license=("GPL-3.0-or-later")
arch=('x86_64')

depends=(
  'kcoreaddons'
  'kpmcore'
  'libpwquality'
  'qt6-declarative'
  'qt6-svg'
  'yaml-cpp'
  'python'
)
makedepends=(
  'extra-cmake-modules'
  'libglvnd'
  'ninja'
  'qt6-tools'
  'qt6-translations'
  'python'
)

_pkgext="tar.gz"
source=("$_pkgname-$pkgver.$_pkgext::$url/releases/download/v$pkgver/$_pkgname-$pkgver.$_pkgext"
        "$_pkgname-$pkgver.$_pkgext.asc::$url/releases/download/v$pkgver/$_pkgname-$pkgver.$_pkgext.asc")
sha256sums=('733bbbb00dc9f84874bd5c22960952f317ea2537565431179fa2152b2fbfdccc'
            'f3c898eddaef42abd7f01fd8c3a586c1db4d748550d7775ee9ee32273251199b')
validpgpkeys=('00ACD15E25A79FEE028B0EE57FEA3DA6169C77D6') # Adriaan de Groot <groot@kde.org>

prepare() {
  # Our module, from this repo (the staged checkout is three levels up).
  rm -rf "$srcdir/$_pkgname-$pkgver/src/modules/diskcheck"
  cp -r "$startdir/../../../installer/diskcheck" "$srcdir/$_pkgname-$pkgver/src/modules/diskcheck"
}

build() {
  local _skip_modules=(
    dracut
    dracutlukscfg
    dummycpp
    dummyprocess
    dummypython
    dummypythonqt
    initramfs
    initramfscfg
    interactiveterminal
    packagechooserq
    services-openrc
  )

  # Correct source directory (inside src/)
  local _pkgsrc_dir="$srcdir/$_pkgname-$pkgver"

  local _cmake_options=(
    -B build
    -S "$_pkgsrc_dir"
    -G Ninja
    -DCMAKE_BUILD_TYPE=Release
    -DCMAKE_INSTALL_PREFIX='/usr'
    -DCMAKE_INSTALL_LIBDIR='lib'
    -DWITH_QT6=ON
    -DINSTALL_CONFIG=ON
    -DSKIP_MODULES="${_skip_modules[*]}"
    -DBUILD_TESTING=OFF

    # Explicit KDE install dirs to suppress warnings
    -DKDE_INSTALL_BINDIR=/usr/bin
    -DKDE_INSTALL_SBINDIR=/usr/sbin
    -DKDE_INSTALL_LIBDIR=/usr/lib
    -DKDE_INSTALL_LIBEXECDIR=/usr/libexec
    -DKDE_INSTALL_INCLUDEDIR=/usr/include
    -DKDE_INSTALL_LOCALSTATEDIR=/var
    -DKDE_INSTALL_SHAREDSTATEDIR=/usr/share
    -DKDE_INSTALL_DATAROOTDIR=/usr/share
    -DKDE_INSTALL_DATADIR=/usr/share
    -DKDE_INSTALL_LOCALEDIR=/usr/share/locale
    -DKDE_INSTALL_MANDIR=/usr/share/man
    -DKDE_INSTALL_INFODIR=/usr/share/info
    -DKDE_INSTALL_SYSCONFDIR=/etc

    -Wno-dev
  )

  cmake "${_cmake_options[@]}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
