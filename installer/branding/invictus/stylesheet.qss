/* Invictus installer, Dusk tokens (theme/dusk.toml). Content on basalt,
   text marble, the one next-step button in sol. */
QWidget {
    background-color: #1C1A16;
    color: #ECE6DA;
    font-family: "IBM Plex Sans", "Noto Sans", sans-serif;
    font-size: 11pt;
}
QLabel { background: transparent; }
#sidebarApp, #sidebarApp QWidget { background-color: #14120F; }
QPushButton {
    background-color: #27241F;
    color: #ECE6DA;
    border: 1px solid #3A352D;
    border-radius: 8px;
    padding: 8px 20px;
    min-height: 28px;
}
QPushButton:hover { border-color: #968E7F; }
QPushButton#view-button-next {
    background-color: #E0A64B;
    color: #14120F;
    border: none;
    font-weight: 600;
}
QPushButton#view-button-next:hover { background-color: #F0C274; }
QPushButton:disabled, QPushButton#view-button-next:disabled {
    background-color: #27241F;
    color: #968E7F;
    border: 1px solid #3A352D;
}
QLineEdit, QComboBox, QListView, QTreeView, QTextBrowser, QPlainTextEdit {
    background-color: #27241F;
    color: #ECE6DA;
    border: 1px solid #3A352D;
    border-radius: 6px;
    padding: 6px;
    selection-background-color: #3A352D;
    selection-color: #ECE6DA;
}
QLineEdit:focus, QComboBox:focus { border: 2px solid #E0A64B; }
QCheckBox, QRadioButton { spacing: 10px; background: transparent; }
/* Styling the indicator replaces Qt's own drawing, so draw every state:
   without the border an unticked box was invisible on basalt (seen in the
   first VM boot). */
QCheckBox::indicator, QRadioButton::indicator {
    width: 20px;
    height: 20px;
    background-color: #27241F;
    border: 2px solid #968E7F;
}
QCheckBox::indicator { border-radius: 4px; }
QRadioButton::indicator { border-radius: 11px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: #ECE6DA; }
QCheckBox::indicator:focus, QRadioButton::indicator:focus { border-color: #E0A64B; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #E0A64B;
    border-color: #E0A64B;
}
QProgressBar {
    background-color: #27241F;
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
    color: #ECE6DA;
}
QProgressBar::chunk { background-color: #F0C274; border-radius: 4px; }
#diskCheckTitle { font-size: 20pt; font-weight: 500; }
#diskCheckWarning { color: #BDB4A3; }
/* The Extras page (netinstall's tree). Rows tall enough to hit, the
   "Name / Description" header quiet, and ticks in parchment so the one
   gold on the page stays the Next button (look.md gold rule). Every state
   of the indicator is drawn, as for QCheckBox above. */
QTreeView { padding: 4px; outline: none; }
QTreeView::item { padding: 10px 6px; border: none; }
QTreeView::item:selected { background-color: #3A352D; color: #ECE6DA; }
QTreeView::indicator {
    width: 20px;
    height: 20px;
    background-color: #27241F;
    border: 2px solid #968E7F;
    border-radius: 4px;
}
QTreeView::indicator:hover { border-color: #ECE6DA; }
QTreeView::indicator:checked {
    background-color: #BDB4A3;
    border-color: #BDB4A3;
    /* Without a mark a filled parchment box reads as greyed out. */
    image: url(/usr/share/calamares/branding/invictus/tick.svg);
}
QTreeView::indicator:indeterminate { background-color: #3A352D; border-color: #BDB4A3; }
QHeaderView::section {
    background-color: #27241F;
    color: #968E7F;
    border: none;
    border-bottom: 1px solid #3A352D;
    padding: 6px;
}
