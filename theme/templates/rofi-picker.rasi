/* Generated by invictus-theme from theme "{{meta.name}}". Do not edit.
   The theme picker: launcher styles, no search field, 64 px rows. */
@import "rofi-colors.rasi"

window {
    width: 560px;
    location: north;
    anchor: north;
    y-offset: 18%;
    background-color: @window-bg;
    border: 1px;
    border-color: @line;
    border-radius: 12px;
    padding: 12px;
}
mainbox { background-color: transparent; children: [ message, listview ]; spacing: 8px; }
message { background-color: transparent; border: 0; padding: 4px 0 0 0; order: 2; }
textbox { text-color: @ash; font: "IBM Plex Sans 12"; background-color: transparent; }
listview { lines: 4; scrollbar: false; spacing: 4px; background-color: transparent; fixed-height: false; }
element { padding: 10px; border-radius: 8px; background-color: transparent; text-color: @marble; orientation: horizontal; spacing: 12px; }
element selected.normal { background-color: @stone; text-color: @marble; border: 0 0 0 3px; border-color: @sol; }
element-icon { size: 44px; border-radius: 8px; background-color: transparent; }
element-text { font: "IBM Plex Sans 15"; text-color: inherit; background-color: transparent; vertical-align: 0.5; markup: true; }
