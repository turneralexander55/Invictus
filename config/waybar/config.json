[
  {
    "name": "primary",
    "output": "DP-1",
    "layer": "top",
    "position": "top",
    "height": 32,
    "exclusive": true,
    "spacing": 4,

    "modules-left": ["custom/mark", "hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": [
      "custom/now",
      "tray",
      "custom/updates",
      "custom/alert",
      "pulseaudio",
      "network",
      "custom/swaync"
    ],

    "custom/mark": {
      "format": "󰖙",
      "tooltip": false
    },

    "hyprland/workspaces": {
      "format": "{name}",
      "on-click": "activate",
      "all-outputs": false,
      "active-only": false,
      "persistent-workspaces": {
        "DP-1": [1, 2, 3],
        "DP-2": [4, 5, 6],
        "HDMI-A-2": [7, 8, 9]
      }
    },

    "hyprland/window": {
      "format": "{title}",
      "max-length": 60,
      "separate-outputs": true,
      "rewrite": {
        "desktop": ""
      }
    },

    "clock": {
      "format": "{:%H:%M}",
      "tooltip-format": "<big>{:%A %d %B %Y}</big>\n<tt><small>{calendar}</small></tt>",
      "calendar": {
        "mode": "month",
        "format": {
          "months": "<b>{}</b>",
          "today": "<b><u>{}</u></b>"
        }
      },
      "actions": {
        "on-click": "mode"
      }
    },

    "custom/now": {
      "format": "Now · {}",
      "exec": "head -n 1 \"$HOME/.local/state/invictus/now\" 2>/dev/null | cut -c1-40",
      "interval": 5,
      "max-length": 48,
      "tooltip": false
    },

    "tray": {
      "icon-size": 16,
      "spacing": 8
    },

    "custom/updates": {
      "format": "󰮯 {}",
      "interval": 600,
      "exec": "/usr/lib/invictus/waybar/updates",
      "return-type": "json",
      "on-click": "kitty --hold invictus-update && pkill -RTMIN+8 waybar",
      "signal": 8,
      "tooltip": true
    },

    "custom/alert": {
      "format": "{}",
      "interval": 5,
      "exec": "bash $HOME/.config/waybar/alert.sh",
      "return-type": "json",
      "on-click": "kitty btop",
      "tooltip": true
    },

    "pulseaudio": {
      "format": "{icon} {volume}",
      "format-muted": "󰖁",
      "format-icons": {
        "default": ["󰕿", "󰖀", "󰕾"]
      },
      "scroll-step": 5,
      "on-click": "pavucontrol"
    },

    "network": {
      "format-wifi": "󰤨",
      "format-ethernet": "󰈀",
      "format-disconnected": "󰤭",
      "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
      "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}/{cidr}",
      "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}",
      "tooltip-format-disconnected": "Disconnected",
      "on-click": "nm-connection-editor"
    },

    "custom/swaync": {
      "format": "{icon}",
      "format-icons": {
        "notification": "󰂞",
        "none": "󰂜",
        "dnd-notification": "󰂛",
        "dnd-none": "󰂛",
        "inhibited-notification": "󰂞",
        "inhibited-none": "󰂜",
        "dnd-inhibited-notification": "󰂛",
        "dnd-inhibited-none": "󰂛"
      },
      "return-type": "json",
      "exec": "swaync-client -swb",
      "on-click": "swaync-client -t -sw",
      "on-click-right": "swaync-client -d -sw",
      "escape": true,
      "tooltip": false
    }
  },
  {
    "name": "secondary",
    "output": ["!DP-1"],
    "layer": "top",
    "position": "top",
    "height": 32,
    "exclusive": true,
    "spacing": 4,

    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": [],

    "hyprland/workspaces": {
      "format": "{name}",
      "on-click": "activate",
      "all-outputs": false,
      "active-only": false,
      "persistent-workspaces": {
        "DP-1": [1, 2, 3],
        "DP-2": [4, 5, 6],
        "HDMI-A-2": [7, 8, 9]
      }
    },

    "hyprland/window": {
      "format": "{title}",
      "max-length": 60,
      "separate-outputs": true,
      "rewrite": {
        "desktop": ""
      }
    },

    "clock": {
      "format": "{:%H:%M}",
      "tooltip-format": "<big>{:%A %d %B %Y}</big>\n<tt><small>{calendar}</small></tt>",
      "calendar": {
        "mode": "month"
      },
      "actions": {
        "on-click": "mode"
      }
    }
  }
]
