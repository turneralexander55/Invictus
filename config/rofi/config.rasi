configuration {
    modi: "drun";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    drun-display-format: "{name}  <span size='small' alpha='55%'>{generic}</span>";
    terminal: "kitty";
    /* window and run stay on their own keys: rofi -show window, rofi -show run */
}

@theme "~/.config/rofi/themes/theme.rasi"
