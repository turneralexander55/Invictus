/* Nox Aurea fallback (the default theme) for when ~/.config/invictus/current is missing; the generated file loads after this one and wins. Kept equal to the generated Nox Aurea file by tests/theme/run.sh. */
* {
    night:      #0B0A08;
    basalt:     #131210;
    stone:      #1E1C18;
    line:       #352F26;
    marble:     #EFE6D2;
    parchment:  #C2B8A3;
    ash:        #9A917F;
    sol:        #D9A441;
    sol-bright: #F2D38A;
    pompeii:    #E0775E;
    laurel:     #9BB481;
    lapis:      #84A5D8;
    window-bg:  #131210F0;
}
